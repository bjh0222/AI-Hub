{
  "name": "ai-hub-nav",
  "version": "1.0.0",
  "private": true,
  "description": "AI Hub 导航站 —— 六个官方 AI 对话入口的个人导航页（不接 API、不爬取、不模拟登录）",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register.mjs tests/run.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "verify": "npm run test && npm run typecheck && npm run selfcheck && npm run check-contrast",
    "hash-password": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/hash-password.mjs",
    "gen-secret": "node scripts/gen-secret.mjs",
    "check-env": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register.mjs scripts/check-env.mjs",
    "check-contrast": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-contrast.mjs",
    "selfcheck": "node scripts/selfcheck.mjs"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "puppeteer-core": "^25.13.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
