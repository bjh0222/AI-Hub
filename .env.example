# ============================================================
# AI Hub 导航站 · 环境变量模板
# 用法：复制本文件为 .env.local，填入真实值（.env.local 已被 .gitignore 忽略）
# ============================================================

# ---------- 1) 会话签名密钥（必填）----------
# 生成：npm run gen-secret
# 要求：至少 32 个字符。泄露 = 任何人都能伪造登录态。
SESSION_SECRET=

# ---------- 2) 访问密码（二选一，AUTH_PASSWORD_HASH 优先）----------
# 推荐：密码哈希，明文不落盘。
# 生成（PowerShell，密码不回显）：
#   $s = Read-Host -AsSecureString "设置访问密码"
#   [Runtime.InteropServices.Marshal]::PtrToStringAuto([Runtime.InteropServices.Marshal]::SecureStringToBSTR($s)) | npm run hash-password
# 格式形如 scrypt:16384:8:1:xxxxxxxx:yyyyyyyy
#
# ⚠️ 分隔符是冒号而不是常见的 $，这是刻意的：Next 用 dotenv-expand 解析本文件，
#    值里的 $ 会被当变量展开，写成 scrypt$16384$8$1$... 会让密码永远验证失败。
#    （旧格式仍兼容，但请用 npm run hash-password 重新生成一份新的。）
AUTH_PASSWORD_HASH=

# 仅限本地开发图省事时使用：明文密码。
# ⚠️ 如果密码里含 $，同样会被 dotenv 展开吃掉 —— 请改用上面的哈希方式。
# AUTH_PASSWORD=

# ---------- 3) 可选微调 ----------
# 登录态有效期（秒），默认 14 天
SESSION_TTL_SECONDS=1209600

# Cookie 名称
COOKIE_NAME=aihub_session

# Cookie 的 Secure 属性策略（三档）：
#   auto   ← 默认推荐。按请求协议自动决定：http 访问不加（http://localhost 也能登录），
#            https 直连或反向代理透传 X-Forwarded-Proto: https 时自动加。
#            Tailscale Serve / Caddy 反代场景都靠它，不用改配置。
#   1      强制加 Secure：必须始终用 https 访问（纯 HTTPS 部署可用）
#   0      强制不加：只适合纯 HTTP 内网，会话令牌会明文过网
# ⚠️ 用 http:// 访问却写死 1 的典型症状：填了密码「没反应」，因为浏览器静默丢弃了 Secure Cookie。
COOKIE_SECURE=auto
